# Copy to backend/.env only on the trial host. Never commit the populated file.
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/admin.db

# Generate three independent random values before deployment.
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_BYTES
MFA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_URLSAFE_BASE64_32_BYTE_KEY
AUTH_REQUIRE_MFA=true
AUTH_GUEST_ENABLED=true
AUTH_MAX_ACTIVE_GUEST_SESSIONS=50

# Replace trial.example.com with the real HTTPS origin and host.
CORS_ORIGINS=https://trial.example.com
TRUSTED_HOSTS=trial.example.com
PROXY_TRUSTED_IPS=127.0.0.1
RATE_LIMIT_RPM=60
GUEST_SESSIONS_PER_MINUTE=5
MAX_WS_CONNECTIONS=8
MAX_WS_CONNECTIONS_PER_OWNER=1

DEVICE=cuda
WHISPER_BACKEND=transformers
WHISPER_TORCH_MODEL=openai/whisper-large-v3-turbo
WHISPER_TORCH_REVISION=41f01f3fe87f28c78e2fbf8b568835947dd65ed9
WHISPER_TORCH_LOCAL_ONLY=true
WHISPER_BEAM_SIZE=1
NLLB_MODEL=facebook/nllb-200-distilled-1.3B
NLLB_REVISION=7be3e24664b38ce1cac29b8aeed6911aa0cf0576
TRANSLATION_BEAM_SIZE=1
TRANSLATION_SENTENCE_BATCH_SIZE=4
TTS_MODEL_ENG=facebook/mms-tts-eng
TTS_MODEL_ENG_REVISION=c71de0fe7204c83f1c10820a7d696d0b450048ba
TTS_MODEL_VIE=facebook/mms-tts-vie
TTS_MODEL_VIE_REVISION=b58928d033932a49aa8e3d6cf11625b25fe928d2
TTS_DEVICE=cpu
TTS_DTYPE=float32
PREWARM_MODELS=true
ENABLE_DEEPFILTER=false
STT_WORKER_POOL_SIZE=1
TRANSLATION_WORKER_POOL_SIZE=1
TTS_WORKER_POOL_SIZE=1
