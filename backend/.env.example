# ========================================
# T-LINGUA BACKEND CONFIGURATION
# ========================================
# Copy file này thành .env và điền giá trị thực
# cp .env.example .env

# ── Environment ─────────────────────────
# local | colab | production
APP_ENV=local

# ── Server ──────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── Database ────────────────────────────
# Local (SQLite):
#   sqlite:///./data/admin.db
# Supabase (PostgreSQL):
#   postgresql+asyncpg://postgres.xxxx:password@aws-0-xx.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./data/admin.db

# ── Security ────────────────────────────
# Generate a unique random secret (at least 32 bytes) before starting production.
# Empty local value uses an ephemeral secret; restarting invalidates local sessions.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# HttpOnly refresh cookie lifetime. Active browser sessions renew automatically.
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_GUEST_TOKEN_EXPIRE_MINUTES=15
AUTH_GUEST_ENABLED=true
AUTH_MAX_ACTIVE_GUEST_SESSIONS=500
# Every interactive account must enroll and verify TOTP before logging in.
AUTH_REQUIRE_MFA=true
# Backward-compatible fallback used only when AUTH_REQUIRE_MFA is omitted.
AUTH_REQUIRE_PRIVILEGED_MFA=true
# Independent Fernet encryption key; required for MFA enrollment and production.
MFA_ENCRYPTION_KEY=
# Independent URL-safe Base64 32-byte key used for AES-256-GCM backups.
BACKUP_ENCRYPTION_KEY=

# ── CORS ────────────────────────────────
# Comma-separated origins. Dùng * cho dev, domain cụ thể cho production.
# Ví dụ: https://admin.tlingua.com,https://app.tlingua.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:7357,http://127.0.0.1:7357
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
PROXY_TRUSTED_IPS=127.0.0.1
MAX_TEXT_CHARS=5000
RATE_LIMIT_RPM=60
GUEST_SESSIONS_PER_MINUTE=5
MAX_AUDIO_UPLOAD_BYTES=1000000
MAX_DICTIONARY_UPLOAD_BYTES=1000000
MAX_WS_CONNECTIONS=8
MAX_WS_CONNECTIONS_PER_OWNER=1
WS_CONFIG_TIMEOUT_SECONDS=5
WS_IDLE_TIMEOUT_SECONDS=60
WS_MAX_MESSAGE_BYTES=16384
WS_BYTES_PER_SECOND=64000
QA_RETENTION_DAYS=30

# ── AI Device ───────────────────────────
# auto | cuda | cpu
# auto = tự detect GPU, dùng cuda nếu có
DEVICE=auto

# ── AI Models ───────────────────────────
# CTranslate2/CPU fallback when the preferred GPU model is unavailable.
WHISPER_MODEL=small
WHISPER_BACKEND=auto
# Auto uses the PyTorch GPU checkpoint and downloads it once into the HF cache.
# Set local-only to true for offline hosts; auto then falls back to CTranslate2.
# Preferred GPU model. On GPUs with sufficient VRAM, this can be changed to
# openai/whisper-large-v3, at the cost of higher memory use and latency.
WHISPER_TORCH_MODEL=openai/whisper-large-v3-turbo
WHISPER_TORCH_REVISION=41f01f3fe87f28c78e2fbf8b568835947dd65ed9
WHISPER_TORCH_LOCAL_ONLY=false
WHISPER_COMPUTE_TYPE=auto
# Whisper can use CPU independently of the Torch models when CUDA runtime DLLs
# required by CTranslate2 are unavailable. /admin/system/status reports the
# effective device, compute type, fallback state, and model load duration.
WHISPER_DEVICE=auto
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=3
NLLB_MODEL=facebook/nllb-200-distilled-1.3B
NLLB_REVISION=7be3e24664b38ce1cac29b8aeed6911aa0cf0576
TRANSLATION_BEAM_SIZE=1
TTS_MODEL_ENG=facebook/mms-tts-eng
TTS_MODEL_ENG_REVISION=c71de0fe7204c83f1c10820a7d696d0b450048ba
TTS_MODEL_VIE=facebook/mms-tts-vie
TTS_MODEL_VIE_REVISION=b58928d033932a49aa8e3d6cf11625b25fe928d2

# ── Optional AI Tweaks ──────────────────
# Hugging Face token (nếu model yêu cầu)
HF_TOKEN=

# DeepFilterNet noise reduction (true/false)
ENABLE_DEEPFILTER=false
DENOISE_ATTENUATION_DB=12
# Preserve consonants in short commands; device noise suppression handles them.
DENOISE_MIN_AUDIO_SECONDS=3.0
# Run one synthetic inference during startup so the first user turn is warm.
PREWARM_MODELS=true

# NLLB optimization flags
NLLB_INT8=0
NLLB_BETTER_TRANSFORMER=0
NLLB_TORCH_COMPILE=0

# Durable Training Center storage. On Colab, point this at a private mounted
# Drive directory so frozen datasets, checkpoints and artifacts survive resets.
# TRAINING_CONTROL_ROOT=/content/drive/MyDrive/T-Lingua/training_control

# Silero VAD pre-filter
USE_SILERO_VAD=0

# Semantic correction mode (none/local/api)
SEMANTIC_CORRECTION_MODE=none

# ── Worker Pool ─────────────────────────
# Giảm trên Colab (1 worker mỗi loại) để tiết kiệm VRAM
STT_WORKER_POOL_SIZE=2
TRANSLATION_WORKER_POOL_SIZE=2
TTS_WORKER_POOL_SIZE=1

# ── Audio ───────────────────────────────
TTS_AUDIO_TTL_SECONDS=300
